# OpenRouter API Key (required) - Get from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Apify API Token (required) - Get from https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# Optional: Override the free model used
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
